# Copy to .env (and keep it out of git) or export these as real environment
# variables. Nothing in this repo reads a committed secret — every key here
# is optional until you switch the corresponding provider away from "mock".

# --- LLM provider ---------------------------------------------------------
# "mock" (default, no key needed) | "claude" | "codex"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- YouTube data source ---------------------------------------------------
# "mock" (default, no key needed) | "api"
YOUTUBE_MODE=mock
YOUTUBE_API_KEY=

# --- Obsidian output ---------------------------------------------------
# Absolute path to your Obsidian vault (or a subfolder inside it). The agent
# writes notes under "<this path>/YouTube/" plus one MOC index note.
OBSIDIAN_VAULT_PATH=./obsidian_vault
